# ContentEngine — docker compose environment.
# Copy to `.env` (`cp .env.example .env`) and fill in the secrets.
# `docker compose` reads this file automatically for variable substitution.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=contentengine
POSTGRES_PORT=5432
# Connection string used by every service. Host is the `db` compose service.
DATABASE_URL=postgresql://postgres:postgres@db:5432/contentengine?schema=public

# --- Auth -------------------------------------------------------------------
# Shared HS256 secret. The web server mints a JWT the API verifies, so this
# MUST be identical for both. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# --- Public URLs ------------------------------------------------------------
# Where the browser reaches the web app (also the CORS origin the API allows).
NEXTAUTH_URL=http://localhost:4200
WEB_ORIGIN=http://localhost:4200
# How the web server reaches the API inside the compose network (rarely change).
INTERNAL_API_URL=http://api:3000

# --- Host port mappings (optional) ------------------------------------------
WEB_PORT=4200
API_PORT=3000

# --- OAuth providers (optional) ---------------------------------------------
# Google:  https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub:  https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Stripe billing (optional until you sell) -------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=
